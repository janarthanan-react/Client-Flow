# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# For local dev / Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clientflow?schema=public"

# Redis Cache & Background Jobs
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="clientflow_super_secret_access_jwt_key_32bytes_min_2025"
JWT_REFRESH_SECRET="clientflow_super_secret_refresh_jwt_key_32bytes_min_2025"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Stripe Integration (Test mode keys)
STRIPE_SECRET_KEY="sk_test_mock_stripe_key_for_clientflow"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook_secret_key"
STRIPE_PRO_PRICE_ID="price_pro_monthly_mock"
STRIPE_BUSINESS_PRICE_ID="price_business_monthly_mock"

# Email Configuration (Nodemailer)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="ClientFlow <notifications@clientflow.io>"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

